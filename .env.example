# Copy to .env and fill in the keys. Never commit .env.
#
# Two secrets, both optional-ish: without OPENROUTER_API_KEY nothing runs;
# without TAVILY_API_KEY the regulator web-search tool disables itself and the
# rest of the agent works.

OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
TAVILY_API_KEY=

# Everything below is optional; these are the defaults baked into config.py.
# Settings use the PV_ prefix.

# PV_LLM_BASE_URL=https://openrouter.ai/api/v1
# PV_LLM_MODEL=deepseek/deepseek-v4.1-flash
# PV_LLM_TEMPERATURE=0.1
# PV_LLM_MAX_TOKENS=4096

# Set false to block the web-search tool even when a Tavily key is present.
# PV_ALLOW_WEB_SEARCH=true
